.data 
my_arr: .word 1,2,3,4
size: .word 4
space: .asciiz  ", "

.text
.globl main
main:
 la $t0, my_arr 
 lw $t1, size 
 li $t2, 0 
 
 loop_start: 
 bge $t2,$t1,loop_end  
 sll $t3, $t2, 2
 add $t4, $t3, $t0  
 
lw $t5, 0($t4) 
li $v0, 1
move $a0, $t5 
syscall 

li $v0, 4
la $a0, space
syscall

addi $t2,$t2,1 
j loop_start 

loop_end: 
 li   $v0, 10
    syscall
    
    

